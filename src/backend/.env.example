# Local PostgreSQL connection. Copy this file to .env and adjust as needed.
DATABASE_URL=postgresql://signaldesk:signaldesk@127.0.0.1:5433/tradelens
# Retry transient PostgreSQL startup failures while Docker becomes healthy.
DATABASE_STARTUP_ATTEMPTS=6
DATABASE_STARTUP_DELAY_SECONDS=5
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
# Concurrent equities in an admin full-pipeline run (bounded to 1-8 in code).
ADMIN_PIPELINE_WORKERS=3
# Unattended incremental all-equities run, evaluated in Asia/Kolkata.
PIPELINE_SCHEDULER_ENABLED=true
PIPELINE_SCHEDULE_TIME=19:00
PIPELINE_SCHEDULE_BATCH_SIZE=25
# Free-form questions resolve an equity; evidence currently covers daily primary setups.
CHAT_ENABLED=false
CHAT_PROVIDER=ollama
ONTOP_URL=http://127.0.0.1:8088/sparql
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=45
# Optional alternative provider: CHAT_PROVIDER=gemini.
GEMINI_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
# Set an explicit stable model ID available to your Gemini project.
GEMINI_MODEL=
